local function clearBuffer(buffer, listType)
    for i = 1, MAX_LOGS do
        local log = buffer[i]
        if log then
            if log.BtnInfo then
                ReleaseLogButton(log.BtnInfo)
                log.BtnInfo = nil
            end
            buffer[i] = nil
        end
    end
    writeIndices[listType] = 1
    counts[listType] = 0
end

