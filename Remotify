local logButtonPool = {}

local function GetLogButton()
    local btnInfo = table.remove(logButtonPool)
    if btnInfo then
        return btnInfo
    end

    local btn = LogTemplate:Clone()
    local ind = btn:FindFirstChild("Indicator")
    local badge = btn:FindFirstChild("Badge")
    local nameLabel = btn:FindFirstChild("NameLabel")
    local infoLabel = btn:FindFirstChild("InfoLabel")

    return {
        Btn = btn,
        Ind = ind,
        Badge = badge,
        NameLabel = nameLabel,
        InfoLabel = infoLabel,
        Connection = nil
    }
end

function ReleaseLogButton(btnInfo)
    if not btnInfo then return end
    btnInfo.Btn.Visible = false
    btnInfo.Btn.Parent = nil
    if btnInfo.Connection then
        btnInfo.Connection:Disconnect()
        btnInfo.Connection = nil
    end
    table.insert(logButtonPool, btnInfo)
end

function CreateLogButton(log)
    if log.BtnInfo then return end
    
    local btnInfo = GetLogButton()
    log.BtnInfo = btnInfo
    
    local btn = btnInfo.Btn
    local ind = btnInfo.Ind
    local badge = btnInfo.Badge
    local nameLabel = btnInfo.NameLabel
    local infoLabel = btnInfo.InfoLabel
    
    btn.LayoutOrder = log.LayoutOrder
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    
    local typeColor = typeColors[log.CachedType] or Color3.fromRGB(149, 165, 166)
    ind.BackgroundColor3 = typeColor

    badge.BackgroundColor3 = log.HookType == "incoming" and Color3.fromRGB(120, 60, 160) or Color3.fromRGB(40, 60, 80)
    badge.Text = log.HookType == "incoming" and "IN" or "OUT"

    nameLabel.Text = log.CachedName
    nameLabel.TextColor3 = typeColor

    local callerTxt = log.CallerScript and ("  •  " .. tostring(log.CallerScript)) or ""
    local stackTxt = log.StackCount > 1 and ("  •  " .. log.StackCount .. "x") or ""
    infoLabel.Text = log.Time .. "  •  " .. log.ArgCount .. " args" .. callerTxt .. stackTxt
    
    btnInfo.Connection = btn.MouseButton1Click:Connect(function()
        local function unhighlight(buf)
            for i = 1, MAX_LOGS do
                local l = buf[i]
                if l and l.BtnInfo then
                    l.BtnInfo.Btn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
                end
            end
        end
        unhighlight(buffers.outgoing)
        unhighlight(buffers.incoming)
        
        btn.BackgroundColor3 = Color3.fromRGB(44, 44, 44)
        selectedRemote = log.Remote

        local cachedArgsStr = Serialize(log.FrozenArgs)
        local out = ConstructScript(log.CachedName, log.CachedPath, log.CachedRef, cachedArgsStr, log.ArgCount, log.CachedType)
        if log.CallerScript then
            out = "-- Called by: " .. tostring(log.CallerScript) .. "\n" .. out
