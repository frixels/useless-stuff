local function HighlightLua(code)
    -- Protect against immense performance dips
    if #code > 20000 then
        return code:gsub("<", "&lt;"):gsub(">", "&gt;") .. '\n\n<font color="rgb(255, 100, 100)">--[[ Syntax highlighting disabled: Output is exceptionally large ]]</font>'
    end

    local keywords = {
        ["local"] = true, ["function"] = true, ["end"] = true, ["if"] = true,
        ["then"] = true, ["else"] = true, ["elseif"] = true, ["return"] = true,
        ["for"] = true, ["while"] = true, ["do"] = true, ["repeat"] = true,
        ["until"] = true, ["break"] = true, ["continue"] = true, ["in"] = true,
        ["and"] = true, ["or"] = true, ["not"] = true, ["true"] = true,
        ["false"] = true, ["nil"] = true
    }
    local globals = {
        ["game"] = true, ["workspace"] = true, ["script"] = true,
        ["print"] = true, ["warn"] = true, ["error"] = true,
        ["Vector2"] = true, ["Vector3"] = true, ["CFrame"] = true,
        ["Color3"] = true, ["UDim2"] = true, ["math"] = true,
        ["string"] = true, ["table"] = true, ["unpack"] = true,
        ["_G"] = true
    }
    
    local buffer = {}
    local i = 1
    while i <= #code do
        local char = code:sub(i, i)
        if code:sub(i, i+1) == "--" then
            local endPos = code:find("\n", i) or #code + 1
            local comment = code:sub(i, endPos - 1)
            table.insert(buffer, '<font color="rgb(106, 153, 85)">' .. comment:gsub("<", "&lt;"):gsub(">", "&gt;") .. '</font>')
            i = endPos
        elseif char == '"' or char == "'" then
            local quote = char
            local endPos = i + 1
            local escaped = false
            while endPos <= #code do
                local c = code:sub(endPos, endPos)
                if escaped then
                    escaped = false
                elseif c == "\\" then
                    escaped = true
                elseif c == quote then
                    break
                end
                endPos = endPos + 1
            end
            local str = code:sub(i, endPos)
            table.insert(buffer, '<font color="rgb(206, 145, 120)">' .. str:gsub("<", "&lt;"):gsub(">", "&gt;") .. '</font>')
            i = endPos + 1
        elseif char:match("[%a_]") then
            local endPos = i
            while endPos <= #code and code:sub(endPos, endPos):match("[%w_]") do
                endPos = endPos + 1
            end
            local word = code:sub(i, endPos - 1)
            if keywords[word] then
                table.insert(buffer, '<font color="rgb(86, 156, 214)">' .. word .. '</font>')
            elseif globals[word] then
                table.insert(buffer, '<font color="rgb(78, 201, 176)">' .. word .. '</font>')
            else
                table.insert(buffer, word)
            end
            i = endPos
        elseif char:match("%d") then
            local endPos = i
            while endPos <= #code and code:sub(endPos, endPos):match("[%d%.]") do
                endPos = endPos + 1
            end
            local num = code:sub(i, endPos - 1)
            table.insert(buffer, '<font color="rgb(181, 206, 168)">' .. num .. '</font>')
            i = endPos
        elseif char == ":" or char == "." then
            table.insert(buffer, char)
            i = i + 1
            if i <= #code and code:sub(i, i):match("[%a_]") then
                local endPos = i
                while endPos <= #code and code:sub(endPos, endPos):match("[%w_]") do
                    endPos = endPos + 1
                end
                local method = code:sub(i, endPos - 1)
                table.insert(buffer, '<font color="rgb(220, 220, 170)">' .. method .. '</font>')
                i = endPos
            end
        else
            -- Parentheses wrap forces gsub to return ONLY its first value (the string)
            table.insert(buffer, (char:gsub("<", "&lt;"):gsub(">", "&gt;")))
            i = i + 1
        end
    end
    return table.concat(buffer)
end

-- Generates string paths strictly
local function GetPath(obj)
    if not obj then return "nil" end
    if typeof(obj) ~= "Instance" then return tostring(obj) end
    if not obj.Parent then return "nil --[[ " .. obj.ClassName .. " (No Parent) ]]" end
    if obj == game then return "game" end
    if obj == workspace then return "workspace" end
    if obj.Parent == game then
        return 'game:GetService("' .. obj.ClassName .. '")'
    end
    local path = ""
    local current = obj
    while current and current.Parent and current ~= game do
        local name = current.Name
        if name:match("^[%a_][%w_]*$") then
            path = "." .. name .. path
        else
            path = '["' .. name:gsub('"', '\\"') .. '"]' .. path
        end
        current = current.Parent
    end
    if current == workspace then
        return "workspace" .. path
    else
        return "game" .. path
    end
end

-- Strictly checks the hierarchy via Roblox's internal FindFirstChild to see if paths are identical/ambiguous.
local function GetOptimalPath(obj)
    if typeof(obj) ~= "Instance" then return tostring(obj) end
    if obj == game then return "game" end
    if obj == workspace then return "workspace" end
    
    local isSafe = true
    local current = obj
    
    while current and current ~= game and current ~= workspace do
        if not current.Parent then 
            isSafe = false 
            break 
        end
        if current.Parent == game then
            break -- Services fetched via game:GetService are always unique and safe
        end
        
        -- If FindFirstChild grabs a DIFFERENT instance than us, our name is identical to a sibling that loads first!
        if current.Parent:FindFirstChild(current.Name) ~= current then
            isSafe = false
            break
        end
        
        current = current.Parent
    end
    
    local standardPath = GetPath(obj)
    
    if isSafe then
        return standardPath
    else
        if instanceMap[obj] then
            return instanceMap[obj]
        end
        instanceCounter = instanceCounter + 1
        local key = "SigmaSpy_Inst_" .. instanceCounter
        _G[key] = obj
        
        local ref = '_G["' .. key .. '"]'
        instanceMap[obj] = ref
        return ref
    end
end

-- Fast freeze utility so instances and deep tables don't get lost/modified right as they enter
local function FreezeData(v, visited, depth)
    depth = depth or 0
    if depth > 20 then return "<Max Depth Reached>" end
    
    local t = typeof(v)
    if t == "Instance" then
        local optimalPath = GetOptimalPath(v)
        local rawPath = GetPath(v)
        return { __IS_INSTANCE = true, Ref = optimalPath, Path = rawPath }
    elseif t == "table" then
        visited = visited or {}
        if visited[v] then return "<Cyclic Reference>" end
        visited[v] = true
        
        local newTab = {}
        for k, val in pairs(v) do
            local frozenKey = k
            if type(k) == "table" or typeof(k) == "Instance" then
                frozenKey = FreezeData(k, visited, depth + 1)
            end
            newTab[frozenKey] = FreezeData(val, visited, depth + 1)
        end
        if v.n ~= nil then newTab.n = v.n end
        return newTab
    end
    return v
end

-- Creating a lighter-weight signature utilizing optimal references to correctly stack exactly identical payloads
local function GenerateSignature(v, depth, visited)
    depth = depth or 0
    visited = visited or {}
    if depth > 3 then return "..." end
    local t = type(v)
    if t == "table" then
        if visited[v] then return "<Cyclic>" end
        visited[v] = true
        if v.__IS_INSTANCE then return v.Ref end
        local s = "{"
        local count = 0
        for k, val in pairs(v) do
            if k == "n" and type(val) == "number" then continue end
            if count > 5 then s = s .. "..."; break end
            s = s .. tostring(k) .. ":" .. GenerateSignature(val, depth + 1, visited) .. ","
            count = count + 1
        end
        return s .. "}"
    end
    return tostring(v)
end

-- Extremely fast serialization using table buffers instead of native string appending
local function Serialize(v, indent, visited, buffer)
    local isMain = false
    if not buffer then
        buffer = {}
        isMain = true
    end
    indent = indent or 0
    visited = visited or {}

    if v == nil then 
        table.insert(buffer, "nil")
        if isMain then return table.concat(buffer) end
        return
    end

    local t = typeof(v)
    if t == "string" then
        table.insert(buffer, string.format("%q", v))
    elseif t == "number" or t == "boolean" then
        if v == math.huge then table.insert(buffer, "math.huge")
        elseif v == -math.huge then table.insert(buffer, "-math.huge")
        else table.insert(buffer, tostring(v)) end
    elseif t == "table" then
        if v.__IS_INSTANCE then
            if v.Ref == v.Path then 
                table.insert(buffer, v.Ref)
            else
                table.insert(buffer, v.Ref .. " --[[ " .. v.Path .. " ]]")
            end
        else
            if visited[v] then
                table.insert(buffer, '"--[[ Cyclic Reference ]]"')
            else
                visited[v] = true
                local count = 0
                for _ in pairs(v) do count = count + 1 end
                
                local realCount = count
                if v.n ~= nil then realCount = realCount - 1 end
                
                if realCount == 0 and v.n == nil then
                    table.insert(buffer, "{}")
                else
                    table.insert(buffer, "{\n")
                    local indStr = string.rep("    ", indent + 1)
                    
                    if v.n and type(v.n) == "number" then
                        for i = 1, v.n do
                            table.insert(buffer, indStr)
                            table.insert(buffer, "[" .. i .. "] = ")
                            if v[i] == nil then table.insert(buffer, "nil")
                            else Serialize(v[i], indent + 1, visited, buffer) end
                            table.insert(buffer, ",\n")
                        end
                    else
                        for k, val in pairs(v) do
                            table.insert(buffer, indStr)
                            if type(k) == "string" and k:match("^[%a_][%w_]*$") then
                                table.insert(buffer, k)
                            elseif type(k) == "string" then
                                table.insert(buffer, '["' .. k .. '"]')
                            else
                                table.insert(buffer, "[")
                                Serialize(k, 0, visited, buffer)
                                table.insert(buffer, "]")
                            end
                            table.insert(buffer, " = ")
                            Serialize(val, indent + 1, visited, buffer)
                            table.insert(buffer, ",\n")
                        end
                    end
                    table.insert(buffer, string.rep("    ", indent))
                    table.insert(buffer, "}")
                end
            end
        end
    elseif t == "Vector2" then
        table.insert(buffer, string.format("Vector2.new(%s, %s)", tostring(v.X), tostring(v.Y)))
    elseif t == "Vector3" then
        table.insert(buffer, string.format("Vector3.new(%s, %s, %s)", tostring(v.X), tostring(v.Y), tostring(v.Z)))
    elseif t == "Vector2int16" then
        table.insert(buffer, string.format("Vector2int16.new(%d, %d)", v.X, v.Y))
    elseif t == "Vector3int16" then
        table.insert(buffer, string.format("Vector3int16.new(%d, %d, %d)", v.X, v.Y, v.Z))
    elseif t == "CFrame" then
        table.insert(buffer, string.format("CFrame.new(%s)", tostring(v)))
    elseif t == "UDim" then
        table.insert(buffer, string.format("UDim.new(%s, %s)", tostring(v.Scale), tostring(v.Offset)))
    elseif t == "UDim2" then
        table.insert(buffer, string.format("UDim2.new(%s, %s, %s, %s)", tostring(v.X.Scale), tostring(v.X.Offset), tostring(v.Y.Scale), tostring(v.Y.Offset)))
    elseif t == "Rect" then
        table.insert(buffer, string.format("Rect.new(%s, %s, %s, %s)", tostring(v.Min.X), tostring(v.Min.Y), tostring(v.Max.X), tostring(v.Max.Y)))
    elseif t == "Color3" then
        table.insert(buffer, string.format("Color3.new(%s, %s, %s)", tostring(v.R), tostring(v.G), tostring(v.B)))
    elseif t == "BrickColor" then
        table.insert(buffer, string.format("BrickColor.new(%q)", tostring(v)))
    elseif t == "ColorSequence" then
        if #v.Keypoints > 2 then table.insert(buffer, "nil --[[ ColorSequence (Complex) ]]")
        else
            table.insert(buffer, "ColorSequence.new(")
            Serialize(v.Keypoints[1].Value, indent, visited, buffer)
            table.insert(buffer, ")")
        end
    elseif t == "Ray" then
        table.insert(buffer, "Ray.new(")
        Serialize(v.Origin, indent, visited, buffer)
        table.insert(buffer, ", ")
        Serialize(v.Direction, indent, visited, buffer)
        table.insert(buffer, ")")
    elseif t == "NumberRange" then
        table.insert(buffer, string.format("NumberRange.new(%s, %s)", tostring(v.Min), tostring(v.Max)))
    elseif t == "PhysicalProperties" then
        table.insert(buffer, string.format("PhysicalProperties.new(%s, %s, %s, %s, %s)",
            tostring(v.Density), tostring(v.Friction), tostring(v.Elasticity), tostring(v.FrictionWeight), tostring(v.ElasticityWeight)))
    elseif t == "Faces" then
        local axes = {}
        if v.Top    then table.insert(axes, "Enum.NormalId.Top")    end
        if v.Bottom then table.insert(axes, "Enum.NormalId.Bottom") end
        if v.Left   then table.insert(axes, "Enum.NormalId.Left")   end
        if v.Right  then table.insert(axes, "Enum.NormalId.Right")  end
        if v.Back   then table.insert(axes, "Enum.NormalId.Back")   end
        if v.Front  then table.insert(axes, "Enum.NormalId.Front")  end
        table.insert(buffer, "Faces.new(" .. table.concat(axes, ", ") .. ")")
    elseif t == "EnumItem" then
        table.insert(buffer, tostring(v))
    elseif t == "function" then
        table.insert(buffer, "nil --[[ Function ]]")
    elseif t == "userdata" then
        table.insert(buffer, "nil --[[ Userdata ]]")
    else
        table.insert(buffer, "nil --[[ " .. t .. " ]]")
    end

    if isMain then return table.concat(buffer) end
end

local function ConstructScript(name, path, ref, argsStr, count, remoteType)
    local output = "-- Remote: " .. name .. "\n"
    output = output .. "-- Path: " .. path .. "\n"
    output = output .. "-- Type: " .. remoteType .. "\n"
    if ref ~= path then
        output = output .. "-- Note: Ambiguous path detected, using _G instance cache \n"
    end
    output = output .. "-- Args Count: " .. count .. "\n"
    output = output .. "local args = " .. argsStr .. "\n\n"
    local unpackCall = "unpack(args, 1, " .. count .. ")"
    if remoteType == "RemoteFunction" then
        output = output .. ref .. ":InvokeServer(" .. unpackCall .. ")"
    elseif remoteType == "BindableEvent" then
        output = output .. ref .. ":Fire(" .. unpackCall .. ")"
    elseif remoteType == "BindableFunction" then
        output = output .. ref .. ":Invoke(" .. unpackCall .. ")"
    else
        output = output .. ref .. ":FireServer(" .. unpackCall .. ")"
    end
    return output
end

