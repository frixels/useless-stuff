local function AddLog(info)
    if not scanningEnabled then return end
    if blockedRemotes[info.Remote] then return end
    if excludedRemotes[info.Remote] then return end

    local remote     = info.Remote
    local remoteType = info.RemoteType or "RemoteEvent"
    local args       = info.Args or {}
    local hookType   = info.HookType or "outgoing"
    local callerScript = info.CallerScript

    local cachedPath = GetPath(remote)
    local cachedRef  = GetOptimalPath(remote)
    local cachedName = remote.Name
    local argCount   = args.n or #args
    local timeStr    = os.date("%H:%M:%S")

    -- Freeze data rapidly to prevent lag spikes, while instantly capturing instance states
    local frozenArgs = FreezeData(args)
    local cachedSignature = GenerateSignature(frozenArgs)

    -- Define lookup key using references logic for perfect accuracy
    local lookupKey = GetUniqueInstanceId(remote) .. "_" .. cachedSignature .. "_" .. hookType

    -- Look up matched log in dictionary in O(1) time
    local matchedLog = logLookup[lookupKey]

    if matchedLog then
        -- Stacked logs DO NOT shift: update layout position, stack count and exit
        matchedLog.StackCount = matchedLog.StackCount + 1
        matchedLog.Time = timeStr
        logOrder = logOrder + 1
        matchedLog.LayoutOrder = -logOrder
        
        if matchedLog.BtnInfo then
            matchedLog.BtnInfo.Btn.LayoutOrder = -logOrder
            local callerTxt = matchedLog.CallerScript and ("  •  " .. tostring(matchedLog.CallerScript)) or ""
            matchedLog.BtnInfo.InfoLabel.Text = timeStr .. "  •  " .. matchedLog.ArgCount .. " args" .. callerTxt .. "  •  " .. matchedLog.StackCount .. "x"
        end
        
        updateStatus()
        return
    end

    -- Write directly to our circular buffer using fixed indices
    local listType = hookType
    local buffer = buffers[listType]
    local idx = writeIndices[listType]
    
    local old = buffer[idx]
    if old then
        -- Return to unallocated virtual Object Pool logic
        if old.BtnInfo then 
            ReleaseLogButton(old.BtnInfo) 
            old.BtnInfo = nil
        end
        local oldKey = GetUniqueInstanceId(old.Remote) .. "_" .. old.CachedSignature .. "_" .. old.HookType
        logLookup[oldKey] = nil
    else
        counts[listType] = counts[listType] + 1
    end

    logOrder = logOrder + 1

    local entry = {
        Remote          = remote,
        CachedName      = cachedName,
        CachedPath      = cachedPath,
        CachedRef       = cachedRef,
        FrozenArgs      = frozenArgs,
        CachedSignature = cachedSignature,
        CachedType      = remoteType,
        ArgCount        = argCount,
        Time            = timeStr,
        HookType        = hookType,
        CallerScript    = callerScript,
        StackCount      = 1,
        LayoutOrder     = -logOrder,
        BtnInfo         = nil
    }
    
    buffer[idx] = entry
    logLookup[lookupKey] = entry -- Save to O(1) lookup dictionary
    
    -- Fast modulo circular logic index shift
    writeIndices[listType] = (idx % MAX_LOGS) + 1
    
    -- Lazy loading logic (only load element from pool if currently viewing / searched for)
    local query = searchQuery:lower()
    local nameMatch = query == "" or cachedName:lower():find(query, 1, true) or cachedSignature:lower():find(query, 1, true)
    local filterMatch = (activeFilter == "Out" and hookType == "outgoing") or (activeFilter == "In" and hookType == "incoming")
    
    if nameMatch and filterMatch then
        CreateLogButton(entry)
    end
    
    updateStatus()
end

local function pack(...)
    return { n = select("#", ...), ... }
end

local function hookIncoming(remote)
    if incomingConnections[remote] then return end
    if not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent")) then return end
    incomingConnections[remote] = true
    pcall(function()
        remote.OnClientEvent:Connect(function(...)
            if not scanningEnabled then return end
            if blockedRemotes[remote] or excludedRemotes[remote] then return end
            AddLog({
                Remote = remote,
                RemoteType = "OnClientEvent",
                Args = pack(...),
                HookType = "incoming",
                CallerScript = nil,
            })
        end)
    end)
end

local function secureHookRemote(remote)
    if hookedRemotes[remote] then return end
    hookedRemotes[remote] = true

    if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
        local MyEvent = Instance.new("BindableEvent", game.CoreGui)
        MyEvent.Event:Connect(function(...)
            if blockedRemotes[remote] then return end
            local caller = nil
            pcall(function() caller = sigma.getcallingscript() end)
            AddLog({
                Remote = remote,
                RemoteType = remote.ClassName,
                Args = pack(...),
                HookType = "outgoing",
                CallerScript = caller,
            })
        end)
        pcall(function()
            sigma.rebounceevent(remote, "OnRemoteServerEvent", MyEvent)
        end)
        hookIncoming(remote)

    elseif remote:IsA("RemoteFunction") then
        local MyEvent = Instance.new("BindableEvent", game.CoreGui)
        MyEvent.Event:Connect(function(id, player, ...)
            if blockedRemotes[remote] then return end
            local caller = nil
            pcall(function() caller = sigma.getcallingscript() end)
            AddLog({
                Remote = remote,
                RemoteType = "RemoteFunction",
                Args = pack(...),
                HookType = "outgoing",
                CallerScript = caller,
            })
        end)
        pcall(function()
            sigma.rebounceevent(remote, "RemoteOnInvokeServer", MyEvent)
        end)
    end
end

for _, obj in game:GetDescendants() do
    if obj.Parent ~= game.RobloxReplicatedStorage then
        secureHookRemote(obj)
    end
