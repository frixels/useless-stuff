-- Weak-keyed table to uniquely identify Roblox Instances without relying on tostring()
local instanceIds = setmetatable({}, { __mode = "k" })
local nextInstanceId = 0
local function GetUniqueInstanceId(instance)
    if not instance then return "nil" end
    local id = instanceIds[instance]
    if not id then
        nextInstanceId = nextInstanceId + 1
        id = "inst_" .. nextInstanceId
        instanceIds[instance] = id
    end
    return id
end

