local function removeRemoteFromBuffer(buffer, remote, listType)
    for i = 1, MAX_LOGS do
        local log = buffer[i]
        if log and log.Remote == remote then
            if log.BtnInfo then 
                ReleaseLogButton(log.BtnInfo) 
                log.BtnInfo = nil
            end
            
            -- Evict dictionary reference using unique instance ID
            local key = GetUniqueInstanceId(log.Remote) .. "_" .. log.CachedSignature .. "_" .. log.HookType
            logLookup[key] = nil
            
            buffer[i] = nil
            counts[listType] = counts[listType] - 1
        end
    end
end

