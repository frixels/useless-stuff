local function updateStatus()
    local excCount = 0
    local blkCount = 0
    for _ in pairs(excludedRemotes) do excCount = excCount + 1 end
    for _ in pairs(blockedRemotes) do blkCount = blkCount + 1 end
    
    StatusLabel.Text = "Blocked: " .. blkCount
        .. "  |  Excluded: " .. excCount
        .. "  |  Out: " .. counts.outgoing
        .. "  |  In: " .. counts.incoming
end

-- FORWARD DECLARE UI POOL FUNCTIONS SO THEY CAN BE ACCESSED HERE
local CreateLogButton, ReleaseLogButton

local function updateLogVisibility()
    local query = searchQuery:lower()
    
    local function checkBuffer(buffer)
        for i = 1, MAX_LOGS do
            local log = buffer[i]
            if log then
                local nameMatch = query == ""
                    or log.CachedName:lower():find(query, 1, true)
                    or log.CachedSignature:lower():find(query, 1, true)
                local filterMatch = (activeFilter == "Out" and log.HookType == "outgoing")
                    or (activeFilter == "In"  and log.HookType == "incoming")
                
                if nameMatch and filterMatch then
                    if not log.BtnInfo then
                        CreateLogButton(log)
                    end
                else
                    if log.BtnInfo then
                        ReleaseLogButton(log.BtnInfo)
                        log.BtnInfo = nil
                    end
                end
            end
        end
    end
    
    checkBuffer(buffers.outgoing)
    checkBuffer(buffers.incoming)
end

